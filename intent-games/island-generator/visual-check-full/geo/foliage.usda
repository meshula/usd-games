#usda 1.0
(
    defaultPrim = "foliage"
)

def Xform "foliage"
{
    class Xform "leaf"
    {
        def Mesh "Geo" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.02, 0, -0.015), (0.02, 0.008, 0.015)]
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 1, 5, 6, 2, 2, 6, 7, 3, 3, 7, 4, 0]
            rel material:binding = </foliage/leaf/Materials/foliage>
            point3f[] points = [(-0.02, 0, -0.015), (0.02, 0, -0.015), (0.02, 0, 0.015), (-0.02, 0, 0.015), (-0.02, 0.008, -0.015), (0.02, 0.008, -0.015), (0.02, 0.008, 0.015), (-0.02, 0.008, 0.015)]
            uniform token purpose = "render"
            uniform token subdivisionScheme = "none"
        }

        def "Materials"
        {
            def Material "foliage"
            {
                token outputs:surface.connect = </foliage/leaf/Materials/foliage/PreviewSurface.outputs:surface>

                def Shader "PreviewSurface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.11, 0.4, 0.15)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.85
                    token outputs:surface
                }
            }
        }
    }

    def "leaf_0" (
        instanceable = true
        prepend references = </foliage/leaf>
    )
    {
        double3 xformOp:translate = (0.15, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "leaf_1" (
        instanceable = true
        prepend references = </foliage/leaf>
    )
    {
        double3 xformOp:translate = (0.07499968189088185, 0.05, 0.12990399422753146)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "leaf_2" (
        instanceable = true
        prepend references = </foliage/leaf>
    )
    {
        double3 xformOp:translate = (-0.07500063621688703, 0.1, 0.1299034432455975)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "leaf_3" (
        instanceable = true
        prepend references = </foliage/leaf>
    )
    {
        double3 xformOp:translate = (-0.14999999999595226, 0.15000000000000002, -0.0000011019615309299246)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "leaf_4" (
        instanceable = true
        prepend references = </foliage/leaf>
    )
    {
        double3 xformOp:translate = (-0.07499872756082895, 0.2, -0.12990454520245454)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def "leaf_5" (
        instanceable = true
        prepend references = </foliage/leaf>
    )
    {
        double3 xformOp:translate = (0.07500159053884449, 0.25, -0.12990289225665266)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

