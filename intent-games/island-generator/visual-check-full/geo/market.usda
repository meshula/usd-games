#usda 1.0
(
    defaultPrim = "market"
)

def Xform "market"
{
    def Mesh "Stall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-1.2, 0, -1.2), (1.2, 2.6, 1.2)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 1, 5, 6, 2, 2, 6, 7, 3, 3, 7, 4, 0]
        rel material:binding = </market/Materials/thatch>
        point3f[] points = [(-1.2, 0, -1.2), (1.2, 0, -1.2), (1.2, 0, 1.2), (-1.2, 0, 1.2), (-1.2, 2.6, -1.2), (1.2, 2.6, -1.2), (1.2, 2.6, 1.2), (-1.2, 2.6, 1.2)]
        uniform token purpose = "render"
        uniform token subdivisionScheme = "none"
    }

    def "Materials"
    {
        def Material "thatch"
        {
            token outputs:surface.connect = </market/Materials/thatch/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.52, 0.26)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Mesh "Proxy"
    {
        float3[] extent = [(-1.3, 0, -1.3), (1.3, 2.7, 1.3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 2, 3, 4, 7, 6, 5, 0, 4, 5, 1, 1, 5, 6, 2, 2, 6, 7, 3, 3, 7, 4, 0]
        point3f[] points = [(-1.3, 0, -1.3), (1.3, 0, -1.3), (1.3, 0, 1.3), (-1.3, 0, 1.3), (-1.3, 2.7, -1.3), (1.3, 2.7, -1.3), (1.3, 2.7, 1.3), (-1.3, 2.7, 1.3)]
        uniform token purpose = "proxy"
        uniform token subdivisionScheme = "none"
    }
}

